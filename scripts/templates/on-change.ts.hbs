const handlers: ReadonlyArray<readonly [string, Xrm.Events.Attribute.ChangeEventHandler]> = [
{{#if field}}
  ['{{field}}', {{handlerName}}],
{{/if}}
];

export function registerOnChange(formContext: Xrm.FormContext): void {
  for (const [column, handler] of handlers) {
    formContext.getAttribute(column)?.addOnChange(handler);
  }
}
